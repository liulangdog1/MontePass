<?xml version="1.0"?>
<simulation>
   <project id="vmc0" series="0">
      <parameter name="driver_version"      >    legacy          </parameter>
      <application name="qmcpack" role="molecu" class="serial" version="1.0"/>
   </project>
   <random seed="423"/>
   <qmcsystem>
      <simulationcell>
         <parameter name="bconds">
            n n n
         </parameter>
      </simulationcell>
      <particleset name="e" random="yes" randomsrc="ion0">
         <group name="u" size="4" mass="1.0">
            <parameter name="charge"              >    -1                    </parameter>
            <parameter name="mass"                >    1.0                   </parameter>
         </group>
         <group name="d" size="4" mass="1.0">
            <parameter name="charge"              >    -1                    </parameter>
            <parameter name="mass"                >    1.0                   </parameter>
         </group>
      </particleset>
      <particleset name="ion0">
         <group name="H" size="2" mass="1837.3622207895">
            <parameter name="charge"              >    1                     </parameter>
            <parameter name="valence"             >    1                     </parameter>
            <parameter name="atomicnumber"        >    1                     </parameter>
            <parameter name="mass"                >    1837.3622207895            </parameter>
            <attrib name="position" datatype="posArray" condition="0">
                     0.0000000000       1.4421002308      -1.1065624266
                     0.0000000000      -1.4421002308      -1.1065624266
            </attrib>
         </group>
         <group name="O" size="1" mass="29165.1220462523">
            <parameter name="charge"              >    6                     </parameter>
            <parameter name="valence"             >    6                     </parameter>
            <parameter name="atomicnumber"        >    8                     </parameter>
            <parameter name="mass"                >    29165.1220462523            </parameter>
            <attrib name="position" datatype="posArray" condition="0">
                     0.0000000000       0.0000000000       0.0000000000
            </attrib>
         </group>
      </particleset>
      <wavefunction name="psi0" target="e">
         <determinantset type="MolecularOrbital" href="scf.h5" source="ion0" transform="yes" name="LCAOBSet">
            <slaterdeterminant>
               <determinant id="updet" size="4">
                  <occupation mode="ground"> </occupation>
                  <coefficient size="58" spindataset="0"> </coefficient>
               </determinant>
               <determinant id="downdet" size="4">
                  <occupation mode="ground"> </occupation>
                  <coefficient size="58" spindataset="0"> </coefficient>
               </determinant>
            </slaterdeterminant>
         </determinantset>
      </wavefunction>
      <hamiltonian name="h0" type="generic" target="e">
         <pairpot type="coulomb" name="ElecElec" source="e" target="e"/>
         <pairpot type="coulomb" name="IonIon" source="ion0" target="ion0"/>
         <pairpot type="pseudo" name="PseudoPot" source="ion0" wavefunction="psi0" format="xml">
            <pseudo elementType="H" href="H.ccECP.xml"/>
            <pseudo elementType="O" href="O.ccECP.xml"/>
         </pairpot>
      </hamiltonian>
   </qmcsystem>
   <qmc method="vmc" move="pbyp" checkpoint="-1">
      <parameter name="warmupSteps"         >    100              </parameter>
      <parameter name="blocks"              >    100              </parameter>
      <parameter name="steps"               >    10              </parameter>
      <parameter name="subSteps"            >    3               </parameter>
      <parameter name="timestep"            >    0.3             </parameter>
      <parameter name="samples"             >    2048            </parameter>
      <parameter name="walkers"             >    1               </parameter>
   </qmc>
</simulation>
